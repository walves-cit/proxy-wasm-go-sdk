load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "multiple_dispatches_lib",
    srcs = ["main.go"],
    importpath = "github.com/proxy-wasm/proxy-wasm-go-sdk/examples/multiple_dispatches",
    visibility = ["//visibility:private"],
    deps = [
        "//proxywasm",
        "//proxywasm/types",
    ],
)

go_binary(
    name = "multiple_dispatches",
    embed = [":multiple_dispatches_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "multiple_dispatches_test",
    srcs = ["main_test.go"],
    embed = [":multiple_dispatches_lib"],
    deps = [
        "//proxywasm/proxytest",
        "//proxywasm/types",
        "@com_github_stretchr_testify//require",
    ],
)
