load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "http_headers_lib",
    srcs = ["main.go"],
    importpath = "github.com/proxy-wasm/proxy-wasm-go-sdk/examples/http_headers",
    visibility = ["//visibility:private"],
    deps = [
        "//proxywasm",
        "//proxywasm/types",
        "@com_github_tidwall_gjson//:go_default_library",
    ],
)

go_binary(
    name = "http_headers",
    embed = [":http_headers_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "http_headers_test",
    srcs = ["main_test.go"],
    embed = [":http_headers_lib"],
    deps = [
        "//proxywasm/proxytest",
        "//proxywasm/types",
        "@com_github_stretchr_testify//require",
    ],
)
